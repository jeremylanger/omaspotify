[Unit]
Description=OmaSpotify plugin playback backend
Documentation=https://github.com/jeremylanger/omaspotify
After=graphical-session.target sound.target
Wants=sound.target

[Service]
Type=simple
Environment=PULSE_LATENCY_MSEC=30
Environment=TOKIO_WORKER_THREADS=2
ExecStart=@BACKEND_BINARY@ --config-path=@CONFIG_FILE@
Restart=on-failure
RestartSec=5
TimeoutStopSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
